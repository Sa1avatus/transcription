# Copy to .env and set only the integrations you need. Never commit .env.
HOST=0.0.0.0
PORT=5000
DATA_DIRECTORY=./data
LOG_LEVEL=INFO
LOAD_LOCAL_MODELS=false
WHISPER_MODEL_SIZE=medium
# Keep false on 4 GB GPU when Whisper and NLLB run in the same worker.
ENABLE_QWEN_CORRECTION=false
# Install the optional llama-cpp package only when Qwen correction is enabled.
INSTALL_QWEN=false
RUN_EMBEDDED_WORKER=true
# Docker Compose overrides this with redis://redis:6379/0.
# For local external Redis use redis://localhost:6379/0; leave blank for in-memory queue.
REDIS_URL=
# PostgreSQL connection for Docker Compose/Kubernetes. Compose supplies an
# internal value automatically; use this for a local external database.
DATABASE_URL=
POSTGRES_DB=transcription
POSTGRES_USER=transcription
POSTGRES_PASSWORD=change-this-before-production
# Host directory mounted read-only into the worker at /app/data/models.
MODEL_DIRECTORY=./models
# Set true only when TRANSLATION_BACKEND is nllb_600m or nllb_1300m.
# The GPU Compose override supplies a CUDA PyTorch wheel automatically.
INSTALL_NLLB=false
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=
# Public HTTPS address of the Telegram Mini App, e.g. https://stats.example.com/miniapp
# Leave empty to hide the bot's Statistics menu button.
WEBAPP_URL=
WEBAPP_AUTH_MAX_AGE_SECONDS=3600
TRANSLATION_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
DEEPL_API_KEY=
OMNINET_URL=
OMNINET_LOGIN=
OMNINET_PASSWORD=
# Turn off only for a controlled internal endpoint with a self-signed certificate.
INTERNAL_TLS_VERIFY=true
THIRD_PARTY_URL=
THIRD_PARTY_API_KEY=
