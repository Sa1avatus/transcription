# syntax=docker/dockerfile:1.7
# CUDA 12 + cuDNN 9 runtime required by faster-whisper/CTranslate2 on GPU.
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DEFAULT_TIMEOUT=180 PIP_RETRIES=10
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-worker.txt requirements-nllb.txt .
# Keep each expensive dependency group in its own BuildKit layer. The pip cache
# survives a failed build, so a retry reuses downloaded wheels.
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --upgrade pip
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install -r requirements-worker.txt
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --index-url https://download.pytorch.org/whl/cu126 torch
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install -r requirements-nllb.txt
COPY requirements-db.txt .
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install -r requirements-db.txt
COPY . .
RUN useradd --create-home appuser && mkdir -p /app/data && chown -R appuser:appuser /app
USER appuser
CMD ["python3", "worker_main.py"]
